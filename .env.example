# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env.

# PostgreSQL (dùng cho docker compose)
POSTGRES_PASSWORD=doi-mat-khau-nay

# Ứng dụng API
# Tạo bằng: openssl rand -hex 32  (tối thiểu 32 ký tự)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Khóa mã hóa trường CCCD, tạo bằng:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CCCD_ENCRYPTION_KEY=

# Danh sách origin của frontend, định dạng JSON
CORS_ORIGINS=["http://localhost:3000"]

# Chỉ dùng khi chạy API ngoài docker compose
# DATABASE_URL=postgresql+asyncpg://pmis:doi-mat-khau-nay@localhost:5432/pmis
