{
	admin off
	auto_https off
}

# HTTP trên IP của server (chưa có tên miền nên chưa có chứng chỉ).
# Một origin cho cả web và API nên trình duyệt không cần CORS:
#   /api/*      -> API
#   còn lại     -> web (Next.js)
:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
}
